{
  "name": "piclayout",
  "version": "1.1.1",
  "description": "图片拼贴排版工具",
  "author": "Yuui",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "electron-vite dev --remoteDebuggingPort 9222",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "electron:build": "npm run build && electron-builder --win",
    "electron:build:dir": "npm run build && electron-builder --win --dir",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:mac:dir": "npm run build && electron-builder --mac --dir"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  },
  "dependencies": {
    "@vueuse/core": "^10.0.0",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^2.1.0"
  },
  "allowScripts": {
    "electron@43.1.0": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "vue-demi@0.14.10": true
  }
}

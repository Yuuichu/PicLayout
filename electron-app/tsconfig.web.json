{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.web.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["renderer/src/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["renderer/src/**/*", "shared/**/*"]
}
